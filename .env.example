# Turso Database Configuration
# In production on Vercel, set these in your Vercel Project Settings > Environment Variables:
# Get these by running:
# 1. npx turso auth signup (or login)
# 2. npx turso db create unsent-echoes
# 3. npx turso db show unsent-echoes --url
# 4. npx turso db tokens create unsent-echoes

TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# For local development without Turso cloud, you can leave these blank,
# and it will automatically default to local SQLite ("file:local.db").
